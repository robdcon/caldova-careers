---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDepartments, getLocations, sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = getDepartments(jobs);
const locations = getLocations(jobs);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <form
          class="mb-6 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
          data-testid="role-filters"
        >
          <div>
            <label for="department-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Department
            </label>
            <select
              id="department-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
              data-testid="department-filter"
            >
              <option value="">All departments</option>
              {departments.map((department) => <option value={department}>{department}</option>)}
            </select>
          </div>

          <div>
            <label for="location-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Location
            </label>
            <select
              id="location-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
              data-testid="location-filter"
            >
              <option value="">All locations</option>
              {locations.map((location) => <option value={location}>{location}</option>)}
            </select>
          </div>

          <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:border-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="filter-reset"
          >
            Reset filters
          </button>
        </form>

        <p class="mb-4 text-sm text-slate-400" aria-live="polite" data-testid="filter-results">
          Showing all {jobs.length} roles
        </p>

        <div
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>

        <div hidden data-testid="filter-empty-state">
          <EmptyState text="No roles match those filters. Try adjusting or resetting them." />
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  const departmentFilter = document.querySelector<HTMLSelectElement>('#department-filter');
  const locationFilter = document.querySelector<HTMLSelectElement>('#location-filter');
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="role-filters"]');
  const roleCards = document.querySelectorAll<HTMLElement>('[data-testid="role-card"]');
  const rolesGrid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const filterResults = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const filterEmptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  /** Update rendered role cards and feedback for the current filter selections. */
  function updateRoleVisibility(): void {
    if (
      !departmentFilter ||
      !locationFilter ||
      !rolesGrid ||
      !filterResults ||
      !filterEmptyState
    ) {
      return;
    }

    const department = departmentFilter.value;
    const location = locationFilter.value;
    let visibleRoleCount = 0;

    roleCards.forEach((card) => {
      const matches =
        (!department || card.dataset.department === department) &&
        (!location || card.dataset.location === location);

      card.hidden = !matches;
      if (matches) {
        visibleRoleCount += 1;
      }
    });

    rolesGrid.hidden = visibleRoleCount === 0;
    filterEmptyState.hidden = visibleRoleCount !== 0;
    filterResults.textContent =
      visibleRoleCount === roleCards.length
        ? `Showing all ${visibleRoleCount} roles`
        : `Showing ${visibleRoleCount} of ${roleCards.length} roles`;
  }

  departmentFilter?.addEventListener('change', updateRoleVisibility);
  locationFilter?.addEventListener('change', updateRoleVisibility);
  filterForm?.addEventListener('reset', () => {
    window.requestAnimationFrame(updateRoleVisibility);
  });
</script>
